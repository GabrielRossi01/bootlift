# dotenv-linter:off IncorrectDelimiter

# Copie para .env e rode `npm run local-action` para executar a action
# localmente. Não commite o arquivo .env.

ACTIONS_STEP_DEBUG=true

# Inputs seguem o formato INPUT_<nome> (hífens NÃO viram underscores).
INPUT_PATH=__fixtures__/projects/maven-boot3
INPUT_MODE=full
INPUT_FAIL-ON=error
INPUT_COMMENT-ON-PR=false
INPUT_GITHUB-TOKEN=

# Simula o evento que disparou o workflow (pull_request, push, ...).
GITHUB_EVENT_NAME=push
